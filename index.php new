        </tr>

        <?php endforeach; ?>

    </table>

    <?php else: ?>

        <p>No students found</p>

    <?php endif; ?>

    <!-- Pagination -->
    <div class="pagination">

        <?php if ($page > 1): ?>
            <a href="?search=<?= urlencode($search) ?>&page=<?= $page - 1 ?>">
                Previous
            </a>
        <?php endif; ?>

        <span>Page <?= $page ?> of <?= $totalPages ?></span>

        <?php if ($page < $totalPages): ?>
            <a href="?search=<?= urlencode($search) ?>&page=<?= $page + 1 ?>">
                Next
            </a>
        <?php endif; ?>

    </div>

</div>

</body>
</html>
